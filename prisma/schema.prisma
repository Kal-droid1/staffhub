generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STAFF
  MANAGER
  ADMIN
}

enum AttendanceStatus {
  PENDING
  PRESENT
  ABSENT
  PERMISSION
  ANNUAL_LEAVE
  OTHER
  FIELD_WORK
}

model JobTitle {
  id        String @id @default(uuid())
  name      String @unique
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id              String             @id @default(uuid())
  name            String
  email           String             @unique
  password        String
  role            Role               @default(STAFF)
  department      String?
  jobTitleId      String?
  jobTitle        JobTitle?          @relation(fields: [jobTitleId], references: [id])
  avatarUrl       String?
  isActive        Boolean            @default(true)
  isHidden        Boolean            @default(false)
  hideFromReports Boolean            @default(false)
  isTeacher       Boolean            @default(false)
  deactivatedAt   DateTime?
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  attendance      AttendanceRecord[] @relation("UserAttendance")
  reviewed        AttendanceRecord[] @relation("ReviewedBy")
  leaveGrants     LeaveGrant[]
  documents       StaffDocument[]    @relation("StaffDocuments")
  uploadedDocs    StaffDocument[]    @relation("UploadedDocuments")
  bulkLeaveActions BulkLeaveAction[] @relation("BulkLeaveCreator")
  sundaySchoolClasses SundaySchoolClass[]
  sundaySchoolCoverageTeacher SundaySchoolCoverage[] @relation("SundaySchoolCoverageTeacher")
  sundaySchoolCoverageSubstitute SundaySchoolCoverage[] @relation("SundaySchoolCoverageSubstitute")
  sundaySchoolAttendanceSubmitted SundaySchoolAttendance[] @relation("SundaySchoolAttendanceSubmittedBy")
}

model Settings {
  id                 String  @id @default("singleton")
  cutoffTime         String  @default("09:00")
  officeLatitude     Float?
  officeLongitude    Float?
  allowedRadiusMeters Int    @default(200)
}

model AttendanceRecord {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation("UserAttendance", fields: [userId], references: [id])
  date            DateTime         @db.Date
  signInTime      DateTime?
  requestedStatus AttendanceStatus @default(PRESENT)
  note            String?
  attachmentUrl   String?
  status          AttendanceStatus @default(PENDING)
  leaveTypeId     String?
  leaveType       LeaveType?       @relation(fields: [leaveTypeId], references: [id])
  batchId         String?
  reviewedById    String?
  reviewedBy      User?            @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime         @default(now())

  @@unique([userId, date])
}

model LeaveType {
  id               String             @id @default(uuid())
  name             String             @unique
  isAnnualRecurring Boolean           @default(false)
  mappedStatus     AttendanceStatus
  defaultDays      Float              @default(20)
  requiresAttachment Boolean          @default(false)
  createdAt        DateTime           @default(now())
  grants           LeaveGrant[]
  attendance       AttendanceRecord[]
  bulkLeaveActions BulkLeaveAction[]
}

model BulkLeaveAction {
  id                String      @id @default(uuid())
  label             String?
  leaveTypeId       String?
  leaveType         LeaveType?  @relation(fields: [leaveTypeId], references: [id])
  startDate         DateTime    @db.Date
  endDate           DateTime    @db.Date
  batchId           String      @unique
  createdById       String
  createdBy         User        @relation("BulkLeaveCreator", fields: [createdById], references: [id])
  affectedStaff     Int         @default(0)
  skippedRecords    Int         @default(0)
  insufficientStaff Int         @default(0)
  createdAt         DateTime    @default(now())
}

model LeaveGrant {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  days        Float
  grantedDate DateTime  @db.Date
  note        String?
  expiresAt   DateTime? @db.Date
  createdAt   DateTime  @default(now())
}

model Holiday {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  name      String
  year      Int
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([date, name])
  @@index([year])
}

model Participant {
  id                 String  @id @default(uuid())
  fcpId              String
  fcpName            String
  localParticipantId String  @unique
  name               String
  gradeLevel         String?
  gender             String
  ageText            String?
  communityName      String
  status             String
  createdAt          DateTime @default(now())

  sundaySchoolClasses    SundaySchoolClassParticipant[]
  sundaySchoolAttendance SundaySchoolAttendance[]

  @@index([name])
  @@index([localParticipantId])
}

model StaffDocument {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation("StaffDocuments", fields: [userId], references: [id])
  category     String
  fileUrl      String
  fileName     String
  uploadedById String
  uploadedBy   User      @relation("UploadedDocuments", fields: [uploadedById], references: [id])
  uploadedAt   DateTime  @default(now())
  deletedAt    DateTime?

  @@index([userId, category])
}

model SundaySchoolClass {
  id           String                       @id @default(uuid())
  name         String
  teacherId    String
  teacher      User                         @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  participants SundaySchoolClassParticipant[]
  attendance   SundaySchoolAttendance[]
  coverage     SundaySchoolCoverage[]
  deletedAt    DateTime?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
}

model SundaySchoolClassParticipant {
  id            String            @id @default(uuid())
  classId       String
  class         SundaySchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  participantId String
  participant   Participant       @relation(fields: [participantId], references: [id], onDelete: Cascade)
  assignedAt    DateTime          @default(now())

  @@unique([participantId])
  @@index([classId])
}

model SundaySchoolAttendance {
  id            String            @id @default(uuid())
  participantId String
  participant   Participant       @relation(fields: [participantId], references: [id], onDelete: Cascade)
  classId       String?
  class         SundaySchoolClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  year          Int
  month         Int
  week          Int
  present       Boolean?
  submittedAt   DateTime?
  submittedById String?
  submittedBy   User?             @relation("SundaySchoolAttendanceSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([participantId, year, month, week])
  @@index([classId])
  @@index([year, month])
}

model SundaySchoolCoverage {
  id           String                     @id @default(uuid())
  classId      String
  class        SundaySchoolClass          @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId    String
  teacher      User                       @relation("SundaySchoolCoverageTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  substituteId String
  substitute   User                       @relation("SundaySchoolCoverageSubstitute", fields: [substituteId], references: [id], onDelete: Cascade)
  weeks        SundaySchoolCoverageWeek[]
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@index([classId])
  @@index([substituteId])
}

model SundaySchoolCoverageWeek {
  id         String               @id @default(uuid())
  coverageId String
  coverage   SundaySchoolCoverage @relation(fields: [coverageId], references: [id], onDelete: Cascade)
  year       Int
  month      Int
  week       Int
  createdAt  DateTime             @default(now())

  @@unique([coverageId, year, month, week])
  @@index([year, month, week])
}

