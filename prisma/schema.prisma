generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STAFF
  MANAGER
  ADMIN
}

enum AttendanceStatus {
  PENDING
  PRESENT
  ABSENT
  PERMISSION
  ANNUAL_LEAVE
  OTHER
  FIELD_WORK
}

model JobTitle {
  id        String @id @default(uuid())
  name      String @unique
  createdAt DateTime @default(now())
  users     User[]
}

model User {
  id              String             @id @default(uuid())
  name            String
  email           String             @unique
  password        String
  role            Role               @default(STAFF)
  department      String?
  jobTitleId      String?
  jobTitle        JobTitle?          @relation(fields: [jobTitleId], references: [id])
  avatarUrl       String?
  isActive        Boolean            @default(true)
  isHidden        Boolean            @default(false)
  hideFromReports Boolean            @default(false)
  deactivatedAt   DateTime?
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  attendance      AttendanceRecord[] @relation("UserAttendance")
  reviewed        AttendanceRecord[] @relation("ReviewedBy")
  leaveGrants     LeaveGrant[]
  documents       StaffDocument[]    @relation("StaffDocuments")
  uploadedDocs    StaffDocument[]    @relation("UploadedDocuments")
  bulkLeaveActions BulkLeaveAction[] @relation("BulkLeaveCreator")
}

model Settings {
  id                 String  @id @default("singleton")
  cutoffTime         String  @default("09:00")
  officeLatitude     Float?
  officeLongitude    Float?
  allowedRadiusMeters Int    @default(200)
}

model AttendanceRecord {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation("UserAttendance", fields: [userId], references: [id])
  date            DateTime         @db.Date
  signInTime      DateTime?
  requestedStatus AttendanceStatus @default(PRESENT)
  note            String?
  attachmentUrl   String?
  status          AttendanceStatus @default(PENDING)
  leaveTypeId     String?
  leaveType       LeaveType?       @relation(fields: [leaveTypeId], references: [id])
  batchId         String?
  reviewedById    String?
  reviewedBy      User?            @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime         @default(now())

  @@unique([userId, date])
}

model LeaveType {
  id               String             @id @default(uuid())
  name             String             @unique
  isAnnualRecurring Boolean           @default(false)
  mappedStatus     AttendanceStatus
  defaultDays      Float              @default(20)
  requiresAttachment Boolean          @default(false)
  createdAt        DateTime           @default(now())
  grants           LeaveGrant[]
  attendance       AttendanceRecord[]
  bulkLeaveActions BulkLeaveAction[]
}

model BulkLeaveAction {
  id                String      @id @default(uuid())
  label             String?
  leaveTypeId       String?
  leaveType         LeaveType?  @relation(fields: [leaveTypeId], references: [id])
  startDate         DateTime    @db.Date
  endDate           DateTime    @db.Date
  batchId           String      @unique
  createdById       String
  createdBy         User        @relation("BulkLeaveCreator", fields: [createdById], references: [id])
  affectedStaff     Int         @default(0)
  skippedRecords    Int         @default(0)
  insufficientStaff Int         @default(0)
  createdAt         DateTime    @default(now())
}

model LeaveGrant {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  days        Float
  grantedDate DateTime  @db.Date
  note        String?
  expiresAt   DateTime? @db.Date
  createdAt   DateTime  @default(now())
}

model Holiday {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  name      String
  year      Int
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([date, name])
  @@index([year])
}

model Participant {
  id                 String  @id @default(uuid())
  fcpId              String
  fcpName            String
  localParticipantId String  @unique
  name               String
  gradeLevel         String?
  gender             String
  ageText            String?
  communityName      String
  status             String
  createdAt          DateTime @default(now())

  @@index([name])
  @@index([localParticipantId])
}

model StaffDocument {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation("StaffDocuments", fields: [userId], references: [id])
  category     String
  fileUrl      String
  fileName     String
  uploadedById String
  uploadedBy   User      @relation("UploadedDocuments", fields: [uploadedById], references: [id])
  uploadedAt   DateTime  @default(now())
  deletedAt    DateTime?

  @@index([userId, category])
}
