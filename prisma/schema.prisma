generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STAFF
  MANAGER
  ADMIN
}

enum AttendanceStatus {
  PENDING
  PRESENT
  ABSENT
  PERMISSION
  ANNUAL_LEAVE
  OTHER
  FIELD_WORK
}

model User {
  id              String             @id @default(uuid())
  name            String
  email           String             @unique
  password        String
  role            Role               @default(STAFF)
  department      String?
  isActive        Boolean            @default(true)
  hideFromReports Boolean            @default(false)
  deactivatedAt   DateTime?
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  attendance      AttendanceRecord[] @relation("UserAttendance")
  reviewed        AttendanceRecord[] @relation("ReviewedBy")
  leaveGrants     LeaveGrant[]
  campaigns       ChecklistCampaign[] @relation("CampaignCreator")
  archivedCampaigns ChecklistCampaign[] @relation("ArchivedCampaigns")
  completedEntries ChecklistEntry[]  @relation("EntryCompletions")
}

model Settings {
  id                 String  @id @default("singleton")
  cutoffTime         String  @default("09:00")
  officeLatitude     Float?
  officeLongitude    Float?
  allowedRadiusMeters Int    @default(200)
}

model AttendanceRecord {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation("UserAttendance", fields: [userId], references: [id])
  date            DateTime         @db.Date
  signInTime      DateTime?
  requestedStatus AttendanceStatus @default(PRESENT)
  note            String?
  attachmentUrl   String?
  status          AttendanceStatus @default(PENDING)
  leaveTypeId     String?
  leaveType       LeaveType?       @relation(fields: [leaveTypeId], references: [id])
  batchId         String?
  reviewedById    String?
  reviewedBy      User?            @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime         @default(now())

  @@unique([userId, date])
}

model LeaveType {
  id               String             @id @default(uuid())
  name             String             @unique
  isAnnualRecurring Boolean           @default(false)
  mappedStatus     AttendanceStatus
  defaultDays      Float              @default(20)
  requiresAttachment Boolean          @default(false)
  createdAt        DateTime           @default(now())
  grants           LeaveGrant[]
  attendance       AttendanceRecord[]
}

model LeaveGrant {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  days        Float
  grantedDate DateTime  @db.Date
  note        String?
  expiresAt   DateTime? @db.Date
  createdAt   DateTime  @default(now())
}

model Holiday {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  name      String
  year      Int
  isDefault Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([date, name])
  @@index([year])
}

model Participant {
  id                 String             @id @default(uuid())
  fcpId              String
  fcpName            String
  localParticipantId String             @unique
  name               String
  gradeLevel         String?
  gender             String
  ageText            String?
  communityName      String
  status             String
  createdAt          DateTime           @default(now())
  checklistEntries   ChecklistEntry[]

  @@index([name])
  @@index([localParticipantId])
}

enum CampaignVisibility {
  ALL_STAFF
  CREATOR_ONLY
}

enum CampaignStatus {
  ACTIVE
  ARCHIVED
}

model ChecklistCampaign {
  id           String             @id @default(uuid())
  name         String
  createdById  String
  createdBy    User               @relation("CampaignCreator", fields: [createdById], references: [id])
  visibility   CampaignVisibility @default(ALL_STAFF)
  status       CampaignStatus     @default(ACTIVE)
  createdAt    DateTime           @default(now())
  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?              @relation("ArchivedCampaigns", fields: [archivedById], references: [id])
  entries      ChecklistEntry[]

  @@index([status])
}

model ChecklistEntry {
  id            String           @id @default(uuid())
  campaignId    String
  campaign      ChecklistCampaign @relation(fields: [campaignId], references: [id])
  participantId String
  participant   Participant      @relation(fields: [participantId], references: [id])
  completed     Boolean          @default(false)
  completedById String?
  completedBy   User?            @relation("EntryCompletions", fields: [completedById], references: [id])
  completedAt   DateTime?

  @@unique([campaignId, participantId])
}
